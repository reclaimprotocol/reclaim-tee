# Committable build pins for the SEV-SNP image — the SNP analogue of the CS
# pinned Dockerfiles. Sourced by deploy/snp-build.sh (and read by snp-pair.sh
# for the peer digest) so the base UKI (PCR 11) and the app bundle (PCR 8 /
# snp-app digest) are byte-reproducible. Bumping a value here is the ONLY way
# the measured identity changes — do it deliberately. No deployment-specific
# data: public package versions + the build's own digests.

# --- base UKI inputs (PCR 11, per-cloud kernel + systemd stub/ukify) ---
SNP_GCP_KERNEL_PKG="linux-image-6.17.0-1018-gcp=6.17.0-1018.19~24.04.1"
SNP_AWS_KERNEL_PKG="linux-image-6.17.0-1017-aws=6.17.0-1017.17~24.04.1"
SNP_SYSTEMD_BOOT_VER="255.4-1ubuntu8.16"
SNP_SYSTEMD_UKIFY_VER="255.4-1ubuntu8.16"

# --- app bundle inputs (PCR 8 / snp-app digest) ---
SNP_GO_TOOLCHAIN="go1.26.0"
# CA bundle: extracted at build time from this pinned alpine (ships a Mozilla
# bundle at /etc/ssl/certs/ca-certificates.crt). NOT host certs. Bump to update.
SNP_CA_IMAGE="alpine@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d"

# --- base UKI hash (sha256 of snp-base.efi), per cloud — COMMIT-INDEPENDENT ---
# snp-build.sh asserts the built base UKI matches; a mismatch means unexpected
# base drift (kernel/loader/systemd/cmdline). App digests are NOT pinned here:
# they track the commit and are recorded in image-history.json + allowlisted.
SNP_BASE_UKI_GCP="8d947bf1dce3f3ae1274eafb83c75ebe8906d3f6a32eff111c527ecd71dd9094"
SNP_BASE_UKI_AWS="18a21d844be343785a25840cbe8b3a5a81e80c2b304d8ba10d836658d1ce1fa8"
