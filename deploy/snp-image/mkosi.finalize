#!/bin/bash
set -euo pipefail

# Runs on the built rootfs ($BUILDROOT) before the image (and its dm-verity
# hash) is assembled. Strip the only non-deterministic files so the verity
# roothash is reproducible, and drop the systemd random-seed so no per-image
# entropy is baked into the read-only attested rootfs (entropy comes from the
# SEV-SNP CPU RNG at boot; see crypto/rand getrandom() blocking semantics).

rm -f "${BUILDROOT}/var/cache/ldconfig/aux-cache"
rm -f "${BUILDROOT}/var/log/alternatives.log"
rm -f "${BUILDROOT}/var/lib/systemd/random-seed"
