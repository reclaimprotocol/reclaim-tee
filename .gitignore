# Build artifacts
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
/.env
deploy/build.env

# Operator-local secrets + build artifacts for deploy/*.sh.
# Real values go in deploy/.env (gitignored); deploy/.env.example is
# committed as the placeholder template.
deploy/.env
deploy/v2-digests.env

# Stability driver logs from deploy/stability-run.sh.
stability-*.log
/stability.out

# Proxy runtime configuration (use proxy-config.json.example as template)
proxy-config.json
kms_cache.json
/js_sdk/node_modules/
/js_sdk/dist/
/js_sdk/.idea/

# SEV-SNP (snp branch) image build artifacts — large, regenerable, machine-specific.
# Build recipe SOURCE (Go, mkosi.conf/repart/finalize, Dockerfile, service units)
# is committed; the operator/build *.sh under deploy/ stay untracked per convention.
deploy/snp-image/*.raw
deploy/snp-image/*.efi
deploy/snp-image/*.zst
deploy/snp-image/*.blob
deploy/snp-image/snp-verity
deploy/snp-image/snp-verity.initrd
deploy/snp-image/snp-verity.vmlinuz
deploy/snp-image/initrd
deploy/snp-image/manifest.*.txt
deploy/snp-image/.image-tag
deploy/snp-image/mkosi.output/
deploy/snp-image/mkosi.cache/
deploy/snp-image/mkosi.extra/usr/local/bin/
snp-poc/snp-poc
deploy/snp-image/app-bundle.tar
